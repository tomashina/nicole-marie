{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ text_info }}</h3>
      </div>
      <div class="panel-body">
        <div class="row">
          <div class="col-sm-6">
            <fieldset>
              <legend>{{ text_order }}</legend>
              <table class="table table-bordered">
                <tbody>
                  <tr>
                    <td><b>{{ entry_request_id }}</b></td>
                    <td>#{{ withdrawal.contract_withdrawal_id }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_order_id }}</b></td>
                    <td><a href="{{ order_link }}">#{{ withdrawal.order_id }}</a></td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_scope }}</b></td>
                    <td>{{ withdrawal.scope_text }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_status }}</b></td>
                    <td>{{ status_text }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ column_date_submitted }}</b></td>
                    <td>{{ withdrawal.date_submitted }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ column_date_modified }}</b></td>
                    <td>{{ withdrawal.date_modified }}</td>
                  </tr>
                </tbody>
              </table>
            </fieldset>
          </div>
          <div class="col-sm-6">
            <fieldset>
              <legend>{{ text_customer }}</legend>
              <table class="table table-bordered">
                <tbody>
                  <tr>
                    <td><b>{{ entry_firstname }} / {{ entry_lastname }}</b></td>
                    <td>{{ withdrawal.firstname }} {{ withdrawal.lastname }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_email }}</b></td>
                    <td><a href="mailto:{{ withdrawal.email }}">{{ withdrawal.email }}</a></td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_telephone }}</b></td>
                    <td>{{ withdrawal.telephone }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_address }}</b></td>
                    <td style="white-space: pre-wrap;">{{ withdrawal.address }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_refund_iban }}</b></td>
                    <td>{{ withdrawal.refund_iban }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_ip }}</b></td>
                    <td>{{ withdrawal.ip }}</td>
                  </tr>
                  <tr>
                    <td><b>{{ entry_user_agent }}</b></td>
                    <td>{{ withdrawal.user_agent }}</td>
                  </tr>
                </tbody>
              </table>
            </fieldset>
          </div>
        </div>

        <fieldset>
          <legend>{{ text_statement }}</legend>
          <pre class="well" style="white-space: pre-wrap;">{{ withdrawal.statement }}</pre>
          {% if withdrawal.comment %}
            <table class="table table-bordered">
              <tbody>
                <tr>
                  <td style="width: 200px;"><b>{{ entry_comment }}</b></td>
                  <td style="white-space: pre-wrap;">{{ withdrawal.comment }}</td>
                </tr>
              </tbody>
            </table>
          {% endif %}
        </fieldset>

        <fieldset>
          <legend>{{ text_products }}</legend>
          {% if withdrawal.products %}
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-left">{{ column_product }}</td>
                    <td class="text-left">{{ column_model }}</td>
                    <td class="text-right">{{ column_quantity }}</td>
                  </tr>
                </thead>
                <tbody>
                  {% for product in withdrawal.products %}
                    <tr>
                      <td class="text-left">{{ product.name }}</td>
                      <td class="text-left">{{ product.model }}</td>
                      <td class="text-right">{{ product.quantity }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <p>{{ text_missing_products }}</p>
          {% endif %}
        </fieldset>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-history"></i> {{ text_history }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_date_added }}</td>
                <td class="text-left">{{ column_status }}</td>
                <td class="text-left">{{ column_comment }}</td>
                <td class="text-left">{{ column_notify }}</td>
                <td class="text-left">{{ column_user }}</td>
              </tr>
            </thead>
            <tbody>
              {% if histories %}
                {% for history in histories %}
                  <tr>
                    <td class="text-left">{{ history.date_added }}</td>
                    <td class="text-left">{{ history.status }}</td>
                    <td class="text-left">{{ history.comment }}</td>
                    <td class="text-left">{{ history.notify }}</td>
                    <td class="text-left">{{ history.user }}</td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="text-center" colspan="5">{{ text_no_results }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>

        <fieldset>
          <legend>{{ text_history_add }}</legend>
          <form action="{{ action }}" method="post" class="form-horizontal">
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="status" id="input-status" class="form-control">
                  {% for status_code, status_name in statuses %}
                    <option value="{{ status_code }}" {% if status_code == status %}selected="selected"{% endif %}>{{ status_name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-notify">{{ entry_notify }}</label>
              <div class="col-sm-10">
                <input type="checkbox" name="notify" value="1" id="input-notify" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-comment">{{ entry_comment }}</label>
              <div class="col-sm-10">
                <textarea name="comment" rows="5" id="input-comment" class="form-control"></textarea>
              </div>
            </div>
            <div class="text-right">
              <button type="submit" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_history_add }}</button>
            </div>
          </form>
        </fieldset>
      </div>
    </div>
  </div>
</div>
{{ footer }}
