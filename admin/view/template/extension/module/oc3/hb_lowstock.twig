{{ header }}{{ column_left }}

<div id="content">
 <!--Header Start-->
 <div class="page-header">
  <div class="container-fluid">
		{% if update_info %}
			<div class="alert alert-warning"><i class="fa fa-fire" aria-hidden="true"></i>&nbsp;{{ update_info }}</div>
		{% endif %}
		
   <div class="pull-right"> 
		 <button type="submit" form="form-setting" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i>&nbsp;{{ button_save }}</button>
		 <a onclick="export2csv();" class="btn btn-success"><i class="fa fa-file-excel-o"></i>&nbsp;{{ text_export }}</a> 
		 <a href="https://www.huntbee.com/documentation/docs/low-stock-management/" target="_blank" class="btn btn-default"><i class="fa fa-book"></i>&nbsp;{{ button_docs }}</a>
     <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a> 
	 </div>
   <h1>{{ heading_title }}</h1>
   <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
   </ul>
  </div>
 </div>
 <!--Header End-->
 <div class="container-fluid">
	<!--Start - Error / Success Message if any -->
	{% if error_warning %}
		<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
		<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
	{% endif %}
	{% if success %}
		<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
		<button type="button" class="close" data-dismiss="alert">&times;</button>
		</div>
	{% endif %}
	<!--End - Error / Success Message if any -->
	
  <div class="panel panel-default">
   <div class="panel-heading">
    <h3 class="panel-title"><i class="fa fa-battery-quarter"></i> {{ heading_title }}</h3>
   </div>
   <div class="panel-body">
    <div id="output-console"></div>

    <!--Tabs UL Starts-->
    <ul class="nav nav-tabs" id="tabs">
     <li class="active"><a href="#tab-products" onclick="loadBlock('products');" data-toggle="tab"><i class="fa fa-list"></i>&nbsp;{{ tab_report }}</a></li>
     <li><a href="#tab-setting" data-toggle="tab"><i class="fa fa-gear"></i>&nbsp;{{ tab_setting }}</a></li>
		 <li><a href="#tab-template" onclick="loadBlock('templates');" data-toggle="tab"><i class="fa fa-newspaper-o" aria-hidden="true"></i>&nbsp;{{ tab_template }}</a></li>
     <li><a href="#tab-logs" onclick="loadBlock('logs');" data-toggle="tab"><i class="fa fa-book"></i>&nbsp;{{ tab_log }}</a></li>
    </ul>
    <!--Tabs UL Ends-->
    <div class="tab-content">
     <!--UL TAB MAIN CONTAINER-->
     <!--LIST CONTAINER-->
     <div class="tab-pane active" id="tab-products">
			<div class="row" style="margin-bottom:10px;">
				<div class="col-sm-4">
					<div class="input-group">
						<input type="text" id="search-product-value" onkeyup="searchProduct();" class="form-control" placeholder="{{ text_search_product }}">
						<span class="input-group-addon btn" id="search-product-button" onclick="searchProduct();"><i class="fa fa-search"></i></span> 
					</div>
				</div>

				<div class="col-sm-3">
					{% if hb_lowstock_dashboard_mode == 'all' %}
					<div class="input-group">
						<span class="input-group-addon">{{ text_category }}</span>
						<input type="text" id="category_lookup" class="form-control" autocomplete="off" placeholder="{{ text_category_lookup }}">
						<input type="hidden" id="search_category_id">
					</div>
					{% endif %}
				</div>

				<div class="col-sm-3">
					<div class="input-group">
						<span class="input-group-addon">{{ text_manufacturer }}</span>
						<input type="text" id="manufacturer_lookup" class="form-control" autocomplete="off" placeholder="{{ text_manufacturer_lookup }}">
						<input type="hidden" id="search_manufacturer_id">
					</div>
				</div>

				<div class="col-sm-2">
					<div class="input-group">
						<span class="input-group-addon"><i class="fa fa-filter"></i>&nbsp;{{ text_status }}</span>
						<select id="search_status" class="form-control" onchange="searchProduct();">
							<option value="">{{ text_all }}</option>
							<option value="1">{{ text_enable }}</option>
							<option value="0">{{ text_disable }}</option>
						</select>
					</div>
				</div>
			</div>

			<div class="row">
				
			</div>

			<div id="products-block"></div>
     </div>

     <div class="tab-pane" id="tab-setting"> 
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-setting" class="form-horizontal">
				
				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_lowstock_nostock_template }}</label>
					<div class="col-sm-4">
						<select class="form-control" name="hb_lowstock_nostock_template">
							<option value="0"> No Templates </option>
							{% if email_templates %}
								{% for template in email_templates %}
									<option value="{{ template.id }}" {{ hb_lowstock_nostock_template == template.id?'selected':'' }}>{{ template.template_label }}</option>
								{% endfor %}
							{% endif %}
						</select>
					</div>	
					<div class="col-sm-3">
						<div class="input-group">
							<span class="input-group-addon"><i class="fa fa-envelope"></i>&nbsp;{{ text_lowstock_to }}</span>
							<input type="text" name="hb_lowstock_nostock_to" class="form-control" value="{{ hb_lowstock_nostock_to }}">
						</div>
					</div>	
					<div class="col-sm-2">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_nostock_status" class="form-control" value="1" {{ hb_lowstock_nostock_status == 1? 'checked':'' }}/>
					</div>		
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_lowstock_template }}</label>
					<div class="col-sm-4">
						<select class="form-control" name="hb_lowstock_template">
							<option value="0"> No Templates </option>
							{% if email_templates %}
								{% for template in email_templates %}
									<option value="{{ template.id }}" {{ hb_lowstock_template == template.id?'selected':'' }}>{{ template.template_label }}</option>
								{% endfor %}
							{% endif %}
						</select>
					</div>	
					<div class="col-sm-3">
						<div class="input-group">
							<span class="input-group-addon"><i class="fa fa-envelope"></i>&nbsp;{{ text_lowstock_to }}</span>
							<input type="text" name="hb_lowstock_to" class="form-control" value="{{ hb_lowstock_to }}">
						</div>
					</div>	
					<div class="col-sm-2">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_status" class="form-control" value="1" {{ hb_lowstock_status == 1? 'checked':'' }}/>
					</div>		
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_lowstock_qty }}</label>
					<div class="col-sm-3">
						<input type="number" name="hb_lowstock_qty" class="form-control" value="{{ hb_lowstock_qty }}" />
					</div>
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_trigger_orderstatus }}</label>
					<div class="col-sm-9">
					 <div class="well well-sm" style="height: 150px; overflow: auto;">
						{% for order_status in order_statuses %}
						<div class="checkbox">
						 <label>
							{% if order_status.order_status_id in hb_lowstock_order_statuses%}
							<input type="checkbox" name="hb_lowstock_order_statuses[]" value="{{ order_status.order_status_id }}" checked="checked" />
							{{ order_status.name }}
							{% else %} 
							<input type="checkbox" name="hb_lowstock_order_statuses[]" value="{{ order_status.order_status_id }}" />
							{{ order_status.name }}
							{% endif %}
						 </label>
						</div>
						{% endfor %}
					 </div>
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_oopv_validation }}</label>
					<div class="col-sm-9">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_opov_validation" class="form-control" value="1" {{ hb_lowstock_opov_validation == 1? 'checked':'' }}/>
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_alternate_trigger }}</label>
					<div class="col-sm-9">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_alt_trigger" class="form-control" value="1" {{ hb_lowstock_alt_trigger == 1? 'checked':'' }}/>
					</div>
				</div>
				
				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_lowstock_nostock_color }}</label>
					<div class="col-sm-3">
						<input type="text" name="hb_lowstock_nostock_color" class="form-control color" value="{{ hb_lowstock_nostock_color }}" />
					</div>				
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_lowstock_edit_mode }}</label>
					<div class="col-sm-3">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_add_mode" class="form-control" value="1" {{ hb_lowstock_add_mode == 1? 'checked':'' }}/>
					</div>				
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_auto_disable }}</label>
					<div class="col-sm-1">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_auto_disable" class="form-control" value="1" {{ hb_lowstock_auto_disable == 1? 'checked':'' }}/>
					</div>	
					<div class="col-sm-2">
						<select name="hb_oosn_stock_status" class="form-control">
							{% for stock_status in stock_statuses %}
								<option value="{{ stock_status.stock_status_id }}" {{ hb_lowstock_auto_disable_ss ==  stock_status.stock_status_id? 'selected':'' }}>{{ stock_status.name }}</option>
							{% endfor %}
						</select>
					</div>			
				</div>
					
				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_list_columns }}</label>
					<div class="col-sm-3">
						<table class="table table-bordered table-hover">
							{% for column in product_columns %} 
								<tr>
									<td>{{ column['column_name'] }}</td>
									<td><input type="checkbox" data-size="small" data-style="android" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_col_{{ column['column_id'] }}" class="form-control" value="1" {{ hb_lowstock_col[column['column_id']] == 1? 'checked':'' }} /></td>
								</tr>
							{% endfor %}
						</table>
					</div>
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_report_mode }}</label>
					<div class="col-sm-3">
						<select name="hb_lowstock_dashboard_mode" class="form-control">
							<option value="low" {{ hb_lowstock_dashboard_mode == 'low'? 'selected':'' }}>{{ text_low_stock_products }}</option>
							<option value="all" {{ hb_lowstock_dashboard_mode == 'all'? 'selected':'' }}>{{ text_all_products }}</option>
						</select>
					</div>
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_enable_logs }}</label>
					<div class="col-sm-9">
						<input type="checkbox" data-toggle="toggle" data-onstyle="success" name="hb_lowstock_worklog" class="form-control" value="1" {{ hb_lowstock_worklog == 1? 'checked':'' }}/>
					</div>
				</div>

				<div class="form-group">
					<label class="col-sm-3 control-label">{{ text_optional_apps }}</label>
					<div class="col-sm-9">
						{% if et_extn_linked %}
							<div class="alert alert-success"><i class="fa fa-check"></i>&nbsp;{{ text_et_connected }}</div><br>
						{% else %} 
							<a class="btn btn-default" href="https://www.huntbee.com/email-template-designer-pro-for-opencart&utm_medium=extension&utm_campaign=add-feature" target="_blank"><i class="fa fa-download"></i>&nbsp;{{ text_install_et }}</a>
						{% endif %}
					</div>
				</div>
				
				</form>
		 </div><!--end tab setting div-->

		<div class="tab-pane" id="tab-template">
		<div class="col-sm-6">
			<div class="row">
				<div class="col-sm-8">
					<div class="input-group">
						<input type="text" id="search-value" onkeyup="searchTemplate();" class="form-control" placeholder="{{ text_search_label }}">
						<span class="input-group-addon btn" id="search-template-button" onclick="searchTemplate();"><i class="fa fa-search"></i></span>
					</div>
				</div>
				<div class="col-sm-4">
						<a href="{{ create_template }}" class="btn btn-success col-sm-12"><i class="fa fa-plus"></i>&nbsp;{{ button_create_template }}</a>
				</div>
			</div>
			
			<div class="row" style="margin-top:10px;">
				<div class="col-sm-12">
					<div id="templates-block">LIST</div>
				</div>
			</div>
		</div>
		
		<div class="col-sm-6">
			<div id="template-preview">
				<center><iframe id="iframe" width="100%" height="800px"></iframe></center>
			</div>
		</div>
		 
		</div><!--end tab template div-->
		 
     
     <!--LOGS TAB-->
     <div class="tab-pane" id="tab-logs">
			<div id="logs-block"></div>

			<div class="pull-right" style="margin-top:10px;">
				<a onclick="confirm('Are you sure?') ? location.href='{{ clear }}' : false;" data-toggle="tooltip" title="Clear Logs" class="btn btn-danger"><i class="fa fa-eraser"></i>&nbsp;{{ button_clear_logs }}</a>
			</div>
		</div>
     <!--end tab logs-->
     
    </div>
    <!--END UL TAB MAIN CONTAINER-->
    
   </div>
  </div>
 </div>
 <div class="container-fluid">
  <!--Huntbee copyrights-->
  <center>
   <span class="help">{{ heading_title }}- {{ extension_version }}&copy; <a href="https://www.huntbee.com/">WWW.HUNTBEE.COM</a> | <a href="https://www.huntbee.com/get-support" target="_blank">SUPPORT</a></span>
  </center>
 </div>
 <!--Huntbee copyrights end-->
</div>

<script type="text/javascript" src="view/javascript/jscolor/jscolor.js"></script>

