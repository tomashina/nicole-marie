{{ header }}
<main class="offcanvas-enabled">
  <div class="page-title-overlap bg-dark pt-4 ps-lg-4 pe-lg-3">
    <div class="container d-lg-flex justify-content-between py-2 py-lg-3">
      <div class="order-lg-2 mb-3 mb-lg-0 pt-lg-2">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb breadcrumb-light flex-lg-nowrap justify-content-center justify-content-lg-start">
            {% for breadcrumb in breadcrumbs %}
              <li class="breadcrumb-item"><a class="text-nowrap" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
            {% endfor %}
          </ol>
        </nav>
      </div>
      <div class="order-lg-1 pe-lg-4 text-center text-lg-start">
        <h1 class="h2 text-light mb-0">{{ text_success_title }}</h1>
      </div>
    </div>
  </div>

  <div id="content" class="container pb-5 mb-2 mb-md-4 ps-lg-4 pe-lg-3">
    <div class="row">
      {{ column_left }}
      <section class="col-lg-8 pt-4">
        <div class="d-none d-lg-flex justify-content-between align-items-center pt-lg-3 pb-4 pb-lg-5 mb-lg-3">
          <h6 class="fs-base text-light mb-0">{{ text_success_title }}</h6>
        </div>

        {{ content_top }}
        <div class="alert alert-success">{{ text_success_message }}</div>

        <div class="table-responsive mb-4">
          <table class="table table-bordered table-striped">
            <tbody>
              <tr>
                <td><b>{{ text_reference }}</b></td>
                <td>#{{ contract_withdrawal_id }}</td>
              </tr>
              <tr>
                <td><b>{{ entry_order_id }}</b></td>
                <td>#{{ order_id }}</td>
              </tr>
              <tr>
                <td><b>{{ entry_email }}</b></td>
                <td>{{ email }}</td>
              </tr>
              <tr>
                <td><b>{{ text_submitted }}</b></td>
                <td>{{ date_submitted }}</td>
              </tr>
              <tr>
                <td><b>{{ text_status }}</b></td>
                <td>{{ status }}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="h5 mb-3">{{ text_statement }}</h2>
        <pre class="p-3 bg-light border rounded mb-4" style="white-space: pre-wrap;">{{ statement }}</pre>

        <div class="d-flex flex-wrap gap-2">
          <a href="{{ account }}" class="btn btn-outline-secondary">{{ text_back_account }}</a>
          <a href="{{ continue }}" class="btn btn-primary">{{ text_continue }}</a>
        </div>
        {{ content_bottom }}
      </section>
    </div>
  </div>
{{ footer }}
