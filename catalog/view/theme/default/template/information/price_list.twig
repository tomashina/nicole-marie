{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      <p>{{ text_intro }}</p>
      {% if publications %}
      <div class="alert alert-info"><strong>{{ text_latest_links }}</strong> <a href="{{ latest_csv }}" rel="nofollow">CSV</a> &middot; <a href="{{ latest_xml }}" rel="nofollow">XML</a></div>
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead><tr><th>{{ column_location }}</th><th>{{ column_published }}</th><th>{{ column_products }}</th><th>{{ column_file }}</th></tr></thead>
          <tbody>
            {% for publication in publications %}
	            <tr><td>{{ publication.location_name|escape }}</td><td>{{ publication.published|escape }}</td><td>{{ publication.product_count }}</td><td><div class="btn-group"><a class="btn btn-primary btn-sm" href="{{ publication.download_csv }}" rel="nofollow">{{ button_download_csv }}</a><a class="btn btn-default btn-sm" href="{{ publication.download_xml }}" rel="nofollow">{{ button_download_xml }}</a></div><br><small>{{ publication.filename|escape }}</small></td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
